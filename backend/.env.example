ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dental
CORS_ORIGINS=["http://localhost:3000"]

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
AUTH_JWT_EXP_MINUTES=15
# Set to true anywhere served over HTTPS.
AUTH_SECURE_COOKIES=false

# Chat model (any OpenAI-compatible API; defaults to DeepSeek). Without a key the chat
# endpoint answers with a safe fallback message.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_CLINIC_TIMEZONE=America/New_York

# Emergency staff notification. The URL is a DUMMY: until it answers 2xx, notifications are
# recorded as failed and the assistant tells the patient to call the clinic.
EMERGENCY_STAFF_WEBHOOK_URL=http://localhost:9000/staff-notifications
EMERGENCY_STAFF_WEBHOOK_TOKEN=

# Integration tests only. Tables in this database are DROPPED on every test run.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dental_test
